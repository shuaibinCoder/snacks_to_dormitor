page {
  min-height: 100%;
  background: #f7f7f5;
  color: #242424;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view, text, image, input, textarea, button, picker, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  font-size: inherit;
}

button::after { border: 0; }

.page { padding: 28rpx 28rpx 180rpx; }
.card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(53, 45, 35, 0.055);
}
.primary-btn {
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #ff8b43, #f45b22);
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(244, 91, 34, .22);
}
.secondary-btn {
  height: 80rpx;
  padding: 0 30rpx;
  border-radius: 40rpx;
  background: #fff3eb;
  color: #ef642b;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ghost-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e8e4df;
  border-radius: 38rpx;
  color: #555;
  display: flex;
  align-items: center;
  justify-content: center;
}
.section-title { font-size: 36rpx; font-weight: 800; letter-spacing: .5rpx; }
.muted { color: #96928d; }
.orange { color: #f26428; }
.price { color: #f05622; font-weight: 800; }
.price-symbol { font-size: 24rpx; }
.empty { padding: 150rpx 40rpx; text-align: center; color: #99938c; }
.empty-icon { display: block; font-size: 92rpx; margin-bottom: 24rpx; }
.form-card { background: #fff; border-radius: 28rpx; padding: 8rpx 28rpx; }
.form-row { min-height: 104rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f0ede9; }
.form-row:last-child { border-bottom: 0; }
.form-label { width: 180rpx; color: #4a4743; font-weight: 600; }
.form-input { flex: 1; text-align: right; min-height: 90rpx; }
.form-textarea { width: 100%; min-height: 150rpx; padding: 24rpx 0; }
.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(18rpx);
  z-index: 20;
}
.tag { display: inline-flex; padding: 8rpx 16rpx; border-radius: 99rpx; background: #f4f1ed; color: #77716a; font-size: 22rpx; }
.status-pill { padding: 8rpx 18rpx; border-radius: 99rpx; font-size: 23rpx; font-weight: 700; }
.status-warn { background: #fff3de; color: #db7c10; }
.status-info { background: #eaf3ff; color: #3479ce; }
.status-success { background: #e9f8ef; color: #27945a; }
.status-muted { background: #f1f1f1; color: #898989; }
