.stores-page{padding-top:24rpx;}.store-list{display:flex;flex-direction:column;gap:20rpx;}.store-card{padding:26rpx;}.store-head{display:flex;align-items:center;}.store-logo{width:88rpx;height:88rpx;border-radius:26rpx;background:#fff0dc;display:flex;align-items:center;justify-content:center;font-size:43rpx;margin-right:18rpx;}.store-main{flex:1;}.store-name{font-size:30rpx;font-weight:900;}.store-owner{font-size:21rpx;color:#969089;margin-top:8rpx;}.platform-state{padding:8rpx 14rpx;border-radius:22rpx;font-size:20rpx;font-weight:750;}.platform-state.active{background:#e9f7ef;color:#288956}.platform-state.suspended{background:#f2f2f2;color:#888}.store-status{display:flex;gap:12rpx;margin-top:22rpx;}.store-status text{padding:8rpx 13rpx;border-radius:12rpx;background:#f6f4f1;color:#77716a;font-size:20rpx;}.store-actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #f0ede9;}.store-actions>view{height:68rpx;}.manage-btn{min-width:160rpx;padding:0 24rpx;border-radius:35rpx;display:flex;align-items:center;justify-content:center;font-weight:750;font-size:23rpx;}.manage-btn.danger{background:#fff0ed;color:#d9574d}.manage-btn.resume{background:#e9f7ef;color:#288956}
