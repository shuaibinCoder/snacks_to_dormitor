.manage-tabs{height:94rpx;background:#fff;display:flex;padding:0 90rpx;gap:80rpx;}.manage-tab{position:relative;flex:1;display:flex;align-items:center;justify-content:center;color:#8f8982;font-weight:700;white-space:nowrap;}.manage-tab.active{color:#292521;font-weight:900;border-bottom:7rpx solid #f36a2e;}.manage-tab>text{margin-left:8rpx;min-width:30rpx;height:30rpx;border-radius:15rpx;background:#f36028;color:#fff;font-size:18rpx;line-height:30rpx;text-align:center;}.manage-page{padding-top:24rpx;}.product-summary{display:flex;align-items:center;padding:8rpx 6rpx 26rpx;}.product-summary>view:not(.add-product){display:flex;flex-direction:column;margin-right:42rpx;}.product-summary text{font-size:36rpx;font-weight:900;}.product-summary label{color:#9b948d;font-size:20rpx;margin-top:5rpx;}.add-product{margin-left:auto;color:#e7642b;font-weight:800;}.merchant-product-list{display:flex;flex-direction:column;gap:18rpx;}.merchant-product{display:flex;align-items:center;padding:22rpx;}.mp-image{width:104rpx;height:104rpx;border-radius:25rpx;background:#fff0d9;display:flex;align-items:center;justify-content:center;font-size:52rpx;margin-right:20rpx;}.mp-main{flex:1;}.mp-name{font-size:28rpx;font-weight:850;}.mp-meta{color:#9b958e;font-size:21rpx;margin-top:8rpx;}.mp-bottom{display:flex;gap:22rpx;margin-top:13rpx;}.stock{font-size:22rpx;color:#6d8d72;background:#edf7ef;padding:5rpx 10rpx;border-radius:10rpx;}.stock.low{color:#e35f2a;background:#fff0e7;}.toggle{width:76rpx;height:48rpx;border-radius:24rpx;background:#ddd;display:flex;align-items:center;justify-content:center;color:#777;font-size:20rpx;}.toggle.on{background:#e9f8ef;color:#278855;}.floating-add{position:fixed;right:34rpx;bottom:50rpx;width:96rpx;height:96rpx;border-radius:50%;background:linear-gradient(135deg,#ff863d,#ef5922);color:#fff;display:flex;align-items:center;justify-content:center;font-size:55rpx;box-shadow:0 13rpx 30rpx rgba(239,89,34,.28);}.add-empty{display:inline-flex;margin-top:24rpx;color:#e66229;font-weight:750;}.merchant-orders{display:flex;flex-direction:column;gap:20rpx;}.m-order{padding:26rpx;}.mo-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:19rpx;border-bottom:1rpx solid #f0ede9;color:#a19a93;font-size:21rpx;}.mo-address{display:flex;align-items:center;padding:23rpx 0;}.mo-address>text{font-size:34rpx;margin-right:16rpx;}.mo-address view>view{font-size:31rpx;font-weight:850;}.mo-address view>text{display:block;color:#8e8881;font-size:22rpx;margin-top:9rpx;}.mo-foot{display:flex;justify-content:space-between;color:#99928b;font-size:22rpx;padding-top:19rpx;border-top:1rpx dashed #e8e3de;}.mo-total{color:#e55e27;font-weight:850;font-size:27rpx;}
.mp-photo { display:block; background:#f2f2f2; }
