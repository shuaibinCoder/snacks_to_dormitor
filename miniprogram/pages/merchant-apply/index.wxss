.apply-page{padding-bottom:80rpx;}.intro-card{padding:38rpx;margin-bottom:30rpx;border-radius:30rpx;background:linear-gradient(135deg,#292622,#4a4139);color:#fff;}.intro-tag,.status-eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#f6a16e;font-weight:800;}.intro-title{font-size:42rpx;font-weight:900;margin-top:16rpx;}.intro-desc{font-size:24rpx;color:#cec5bd;line-height:1.65;margin-top:14rpx;}.status-card{padding:34rpx;border-radius:30rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(50,40,30,.07);margin-bottom:30rpx;}.status-warn{background:linear-gradient(145deg,#fff7e8,#fff);}.status-info{background:linear-gradient(145deg,#edf5ff,#fff);}.status-success{background:linear-gradient(145deg,#eaf8ef,#fff);}.status-muted{background:linear-gradient(145deg,#f2f2f2,#fff);}.status-top{display:flex;justify-content:space-between;align-items:center;}.status-title{font-size:42rpx;font-weight:900;margin-top:12rpx;}.status-icon{font-size:64rpx;}.status-message{margin-top:24rpx;color:#766f68;line-height:1.65;}.payment-box{margin-top:22rpx;padding:24rpx;border-radius:22rpx;background:rgba(255,255,255,.8);display:flex;flex-direction:column;}.payment-box>view{font-size:48rpx;font-weight:900;color:#ed642b;margin:8rpx 0;}.payment-box>text:last-child{font-size:22rpx;color:#8c847d;line-height:1.6;}.progress{display:flex;align-items:flex-start;margin-top:34rpx;}.progress-item{width:64rpx;text-align:center;color:#b3aca5;}.progress-item text{width:48rpx;height:48rpx;border-radius:50%;background:#e5e1dd;display:flex;align-items:center;justify-content:center;margin:auto;font-size:21rpx;font-weight:800;}.progress-item label{font-size:19rpx;display:block;margin-top:8rpx;}.progress-item.done{color:#e5682e;}.progress-item.done text{background:#f36a2d;color:#fff;}.progress-line{flex:1;height:4rpx;background:#e5e1dd;margin-top:22rpx;}.done-line{background:#f36a2d;}.approved-btn,.contact-btn{margin-top:30rpx;}.edit-tip{padding:22rpx 26rpx;border-radius:22rpx;background:#fff0e4;color:#c65e2c;line-height:1.55;}.section-label{font-size:25rpx;font-weight:800;color:#77716a;margin:30rpx 8rpx 15rpx;}.unit{color:#999;margin-left:8rpx;}.agreement{font-size:22rpx;color:#9e978f;line-height:1.7;padding:26rpx 8rpx;}.submit-btn{margin-top:10rpx;}
