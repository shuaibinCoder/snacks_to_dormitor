page{background:#f4f3f0;}.dashboard-hero{padding:34rpx 32rpx 48rpx;background:linear-gradient(145deg,#282522,#413a34);color:#fff;border-radius:0 0 52rpx 52rpx;}.dash-head{display:flex;justify-content:space-between;align-items:center;}.dash-store{display:flex;align-items:center;}.dash-logo{width:84rpx;height:84rpx;border-radius:26rpx;background:#fff0dc;display:flex;align-items:center;justify-content:center;font-size:45rpx;margin-right:18rpx;}.dash-name{font-size:31rpx;font-weight:850;}.dash-state{color:#76d39b;font-size:21rpx;margin-top:8rpx;}.switch-btn{padding:16rpx 24rpx;border-radius:36rpx;background:#f66c31;font-weight:700;font-size:24rpx;}.open-btn{background:#57504a;color:#ddd;}.today-label{color:#bdb4ac;font-size:23rpx;margin-top:45rpx;}.today-label text{margin-left:12rpx;font-size:19rpx;color:#847d76;}.today-amount{font-size:66rpx;font-weight:900;margin-top:5rpx;}.today-amount text{font-size:28rpx;margin-right:8rpx;}.stats-row{display:flex;margin-top:40rpx;}.stats-row view{flex:1;display:flex;flex-direction:column;text-align:center;border-right:1rpx solid #5b534c;}.stats-row view:last-child{border:0;}.stats-row text{font-size:34rpx;font-weight:850;}.stats-row label{font-size:20rpx;color:#aaa29a;margin-top:8rpx;}.dashboard-body{padding:28rpx 28rpx 100rpx;}.pending-alert{display:flex;align-items:center;padding:24rpx;border-radius:24rpx;background:#fff0df;color:#7e5035;}.bell{font-size:38rpx;margin-right:18rpx;}.pending-alert>view{flex:1;}.alert-title{font-weight:850;color:#d85e28;}.alert-desc{font-size:21rpx;margin-top:7rpx;}.alert-arrow{font-size:40rpx;}.dash-title{margin:38rpx 4rpx 20rpx;font-size:32rpx;}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;}.tool-card{position:relative;padding:28rpx;min-height:200rpx;text-align:left;display:block;}.tool-icon{width:68rpx;height:68rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;}.order-icon{background:#fff0e4}.product-icon{background:#eaf6ef}.setting-icon{background:#ecf2fb}.share-icon{background:#f5ecfb}.notice-icon{background:#fff0ed}.tool-name{font-size:29rpx;font-weight:850;margin-top:20rpx;}.tool-desc{color:#99928b;font-size:21rpx;margin-top:7rpx;}.badge{position:absolute;right:25rpx;top:25rpx;min-width:38rpx;height:38rpx;padding:0 10rpx;border-radius:20rpx;background:#f45d25;color:#fff;font-size:20rpx;line-height:38rpx;text-align:center;}.share-card{font-size:28rpx;line-height:normal;background:#fff;}.preview{display:flex;justify-content:space-between;align-items:center;padding:27rpx 28rpx;margin-top:22rpx;}.preview-title{font-weight:800;}.preview-desc{font-size:22rpx;color:#9d958e;margin-top:7rpx;}.preview>text{color:#e5652d;font-weight:700;font-size:24rpx;}

.dash-actions{display:flex;align-items:center;gap:14rpx;}.notice-bell{position:relative;width:62rpx;height:62rpx;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:29rpx;}.notice-bell text{position:absolute;right:-8rpx;top:-10rpx;min-width:30rpx;height:30rpx;padding:0 7rpx;border-radius:16rpx;background:#f45d25;color:#fff;font-size:17rpx;line-height:30rpx;text-align:center;}
