page{background:#f4f3f0;}.admin-hero{padding:42rpx 32rpx 50rpx;background:linear-gradient(145deg,#24221f,#443d36);color:#fff;border-radius:0 0 52rpx 52rpx;}.admin-eyebrow{color:#f4a16f;font-size:19rpx;letter-spacing:3rpx;font-weight:800;}.admin-title{font-size:48rpx;font-weight:900;margin-top:14rpx;}.role-pill{display:inline-flex;margin-top:15rpx;padding:8rpx 18rpx;border-radius:30rpx;background:rgba(255,255,255,.12);color:#ddd1c7;font-size:22rpx;}.admin-stats{display:flex;margin-top:44rpx;}.admin-stats>view{flex:1;text-align:center;border-right:1rpx solid #5b534c;display:flex;flex-direction:column;}.admin-stats>view:last-child{border:0;}.admin-stats text{font-size:35rpx;font-weight:900;}.admin-stats label{font-size:19rpx;color:#aaa29b;margin-top:8rpx;}.admin-body{padding-top:32rpx;}.admin-tools{display:flex;flex-direction:column;gap:18rpx;margin-top:20rpx;}.admin-tool{padding:25rpx;display:flex;align-items:center;}.tool-icon{width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:37rpx;margin-right:20rpx;}.orange-bg{background:#fff0e5}.green-bg{background:#eaf7ef}.blue-bg{background:#eaf2fd}.purple-bg{background:#f4ecfb}.red-bg{background:#fff0ed}.yellow-bg{background:#fff7df}.tool-main{flex:1;}.tool-main>view{font-size:29rpx;font-weight:850;}.tool-main>text{display:block;color:#99928a;font-size:21rpx;margin-top:7rpx;}.count{min-width:38rpx;height:38rpx;padding:0 10rpx;border-radius:20rpx;background:#f35f27;color:#fff;line-height:38rpx;text-align:center;font-size:20rpx;}.arrow{font-size:42rpx;color:#c5beb7;margin-left:12rpx;}.log-title{margin-top:38rpx;}.log-card{margin-top:20rpx;padding:10rpx 26rpx;}.log-item{display:flex;padding:20rpx 0;border-bottom:1rpx solid #f0ede9;}.log-item:last-child{border:0;}.log-dot{width:13rpx;height:13rpx;border-radius:50%;background:#f06a30;margin:11rpx 18rpx 0 0;}.log-main>view{font-weight:700;}.log-main>text{display:block;color:#aaa29b;font-size:20rpx;margin-top:6rpx;}.no-log{text-align:center;color:#aaa29b;padding:45rpx 0;}
