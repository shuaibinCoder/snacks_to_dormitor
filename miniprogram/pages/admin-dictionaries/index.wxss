.tabs{height:92rpx;background:#fff;display:flex;padding:0 90rpx;gap:70rpx;position:sticky;top:0;z-index:10;}.tab{flex:1;display:flex;align-items:center;justify-content:center;color:#8d8780;font-weight:700;white-space:nowrap;border-bottom:6rpx solid transparent;}.tab.active{color:#292521;font-weight:900;border-bottom-color:#31577f;}.dictionary-page{padding-top:28rpx;}.dictionary-intro{padding:32rpx;border-radius:28rpx;background:linear-gradient(145deg,#edf4ff,#fff);margin-bottom:26rpx;}.intro-title{font-size:36rpx;font-weight:900;}.intro-desc{color:#687482;font-size:23rpx;line-height:1.7;margin-top:14rpx;}.sync-btn{height:76rpx;border-radius:38rpx;background:#2d527d;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;margin-top:24rpx;}.dictionary-list{display:flex;flex-direction:column;gap:22rpx;}.dictionary-card{padding:28rpx;}.dictionary-head{display:flex;justify-content:space-between;align-items:flex-start;}.dictionary-name{font-size:31rpx;font-weight:900;}.dictionary-code{font-family:monospace;color:#8b94a0;font-size:20rpx;margin-top:8rpx;}.item-count{padding:7rpx 14rpx;border-radius:22rpx;background:#edf3fa;color:#42678f;font-size:20rpx;}.dictionary-description{padding:18rpx 0;color:#746f69;font-size:23rpx;line-height:1.6;border-bottom:1rpx solid #efedea;}.enum-row{padding:20rpx 0;border-bottom:1rpx solid #f0eeeb;}.enum-row:last-child{border:0;padding-bottom:0;}.enum-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;}.enum-label{font-size:27rpx;font-weight:850;}.enum-code{padding:6rpx 11rpx;border-radius:10rpx;background:#f4f2ef;color:#746e67;font-size:18rpx;font-family:monospace;}.field-meta{display:flex;gap:12rpx;margin-top:9rpx;}.field-meta text{padding:5rpx 10rpx;border-radius:9rpx;background:#eef4fa;color:#52708d;font-size:17rpx;}.enum-description{font-size:21rpx;color:#99928b;line-height:1.55;margin-top:9rpx;}
