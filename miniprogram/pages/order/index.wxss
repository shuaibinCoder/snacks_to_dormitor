.detail-page{padding-bottom:180rpx;}.created-banner{display:flex;align-items:center;padding:24rpx 26rpx;margin-bottom:22rpx;border-radius:24rpx;background:#eaf8ef;color:#43805b;font-size:23rpx;}.created-banner>text{width:54rpx;height:54rpx;border-radius:50%;background:#35a865;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;margin-right:18rpx;}.created-title{font-size:29rpx;font-weight:850;color:#23814d;margin-bottom:7rpx;}
.status-card{padding:32rpx;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#fff0df,#fff9ef);}.detail-status{font-size:42rpx;font-weight:900;}.status-desc{font-size:24rpx;color:#8d7b6e;margin-top:12rpx;}.status-emoji{font-size:72rpx;}
.contact-card{margin-top:22rpx;padding:28rpx;display:flex;align-items:center;}.address-icon{font-size:40rpx;margin-right:18rpx;}.address-main{flex:1;}.location{font-size:31rpx;font-weight:850;}.contact{color:#8d8780;font-size:23rpx;margin-top:10rpx;}.phone-btn{width:68rpx;height:68rpx;border-radius:50%;background:#fff0e6;color:#e6682e;display:flex;align-items:center;justify-content:center;font-size:32rpx;}
.goods-card,.info-card,.timeline-card{margin-top:22rpx;padding:28rpx;}.shop-line{display:flex;align-items:center;gap:12rpx;font-weight:850;font-size:29rpx;padding-bottom:20rpx;border-bottom:1rpx solid #f0ede9;}.shop-line text:first-child{font-size:38rpx;}.detail-item{display:flex;align-items:center;padding:20rpx 0;gap:18rpx;}.detail-image{width:78rpx;height:78rpx;border-radius:19rpx;background:#fff0d8;display:flex;align-items:center;justify-content:center;font-size:38rpx;}.detail-name{flex:1;font-weight:650;}.detail-price{width:105rpx;text-align:right;font-weight:700;}.summary-line,.info-line{display:flex;justify-content:space-between;color:#746f69;font-size:24rpx;margin-top:18rpx;}.summary-total{display:flex;justify-content:space-between;align-items:center;padding-top:22rpx;margin-top:22rpx;border-top:1rpx solid #f0ede9;font-weight:800;}.summary-total text:last-child{color:#ed5b24;font-size:36rpx;}.info-title{font-size:29rpx;font-weight:850;margin-bottom:6rpx;}.info-line text:first-child{color:#9c958d;}.info-line text:last-child{max-width:440rpx;text-align:right;}
.timeline-item{position:relative;display:flex;align-items:center;padding:19rpx 0 19rpx 28rpx;border-left:2rpx solid #eee7df;margin-left:5rpx;}.dot{position:absolute;left:-8rpx;width:14rpx;height:14rpx;border-radius:50%;background:#f17236;}.timeline-text{flex:1;font-weight:650;}.timeline-time{color:#aaa39b;font-size:21rpx;}.action-bottom{display:flex;gap:18rpx;}.action-primary{flex:1;}.action-secondary{width:220rpx;}.danger-btn{background:#363330;box-shadow:none;}
.detail-photo { display:block; background:#f2f2f2; }
