.checkout-page { padding-bottom:180rpx; }
.offline-tip { padding:24rpx 26rpx; margin-bottom:24rpx; border-radius:24rpx; background:linear-gradient(135deg,#fff0dc,#fff8ed); display:flex; align-items:center; color:#6d5c4c; }
.tip-emoji { font-size:46rpx; margin-right:20rpx; }.tip-title{font-weight:800;color:#d95f27;}.tip-text{font-size:23rpx;margin-top:6rpx;}
.delivery-card,.order-card{padding:26rpx 28rpx;margin-bottom:24rpx;}.card-title{font-size:31rpx;font-weight:850;margin-bottom:6rpx;}
.picker{flex:1;text-align:right;color:#555;}.picker text{color:#bbb;margin-left:8rpx;}
.shop-title{font-size:29rpx;font-weight:850;padding-bottom:20rpx;border-bottom:1rpx solid #f1eeea;display:flex;align-items:center;}.shop-logo{font-size:38rpx;margin-right:14rpx;}
.checkout-item{display:flex;align-items:center;padding:20rpx 0;}.item-image{width:82rpx;height:82rpx;border-radius:20rpx;background:#fff0d9;display:flex;align-items:center;justify-content:center;font-size:40rpx;margin-right:18rpx;}.item-name{flex:1;font-weight:650;}.item-qty{color:#999;margin:0 24rpx;}.item-price{font-weight:700;}
.fee-row{display:flex;justify-content:space-between;color:#716b65;padding-top:20rpx;font-size:25rpx;}.total-row{text-align:right;padding-top:24rpx;margin-top:20rpx;border-top:1rpx solid #f1eeea;font-weight:700;}.total-row text{font-size:36rpx;color:#ee5b22;margin-left:16rpx;}
.note-card{padding:26rpx 28rpx;display:flex;align-items:center;}.note-label{width:150rpx;font-weight:750;}.note-input{flex:1;text-align:right;}
.safe-note{color:#aaa39b;font-size:22rpx;line-height:1.6;padding:24rpx 12rpx;}
.checkout-bottom{display:flex;align-items:center;gap:24rpx;}.pay-copy{flex:1;display:flex;flex-direction:column;color:#89827b;font-size:22rpx;}.pay-total{color:#ec5a23;font-size:38rpx;font-weight:850;margin-top:4rpx;}.submit-btn{height:88rpx;width:280rpx;border-radius:44rpx;background:linear-gradient(135deg,#ff873e,#ef5721);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:850;}.submitting{opacity:.6;}
.item-photo { display:block; background:#f2f2f2; }
