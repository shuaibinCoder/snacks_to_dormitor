.tabs{position:sticky;top:0;z-index:10;height:94rpx;background:#fff;display:flex;padding:0 36rpx;box-shadow:0 4rpx 14rpx rgba(0,0,0,.03);}.tab{position:relative;flex:1;display:flex;align-items:center;justify-content:center;color:#8c8781;font-weight:650;}.tab.active{color:#292622;font-weight:850;}.tab-line{position:absolute;bottom:8rpx;width:36rpx;height:7rpx;border-radius:4rpx;background:#f36b2d;}
.order-list-page{padding-top:24rpx;}.order-list{display:flex;flex-direction:column;gap:22rpx;}.order-card{padding:26rpx;}.order-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:22rpx;border-bottom:1rpx solid #f1eeeb;}.store-title{font-size:28rpx;font-weight:850;display:flex;align-items:center;}.mini-logo{font-size:36rpx;margin-right:12rpx;}.chevron{font-size:35rpx;color:#bbb;margin-left:9rpx;}.order-goods{display:flex;align-items:center;padding:25rpx 0;}.goods-icons{display:flex;max-width:196rpx;}.goods-icon{width:74rpx;height:74rpx;margin-right:-18rpx;border-radius:20rpx;background:#fff0dc;border:5rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;}.goods-summary{flex:1;min-width:0;margin-left:20rpx;}.goods-names{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:650;}.order-time{color:#aaa39c;font-size:21rpx;margin-top:10rpx;}.order-total{display:flex;flex-direction:column;text-align:right;font-weight:850;font-size:30rpx;}.total-hint{font-size:19rpx;color:#aaa39c;font-weight:400;margin-top:8rpx;}.order-foot{display:flex;justify-content:space-between;color:#8f8982;font-size:22rpx;padding-top:18rpx;border-top:1rpx dashed #e9e5df;}.detail-link{color:#e6652d;font-weight:700;}.go-shop{display:inline-flex;margin-top:30rpx;padding:18rpx 34rpx;border-radius:40rpx;background:#fff0e5;color:#e7652c;font-weight:700;}
.goods-photo { width:100%; height:100%; border-radius:16rpx; display:block; }
