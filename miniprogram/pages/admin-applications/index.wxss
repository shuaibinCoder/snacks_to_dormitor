.filter-bar{height:98rpx;background:#fff;white-space:nowrap;position:sticky;top:0;z-index:10;}.filters{display:inline-flex;height:98rpx;padding:0 24rpx;gap:16rpx;align-items:center;}.filter{padding:15rpx 25rpx;border-radius:32rpx;background:#f3f1ee;color:#77716a;font-size:23rpx;}.filter.active{background:#282522;color:#fff;font-weight:750;}.list-page{padding-top:24rpx;}.application-list{display:flex;flex-direction:column;gap:20rpx;}.application-card{padding:26rpx;}.application-head{display:flex;justify-content:space-between;align-items:flex-start;}.store-name{font-size:31rpx;font-weight:900;}.owner{color:#918a83;font-size:22rpx;margin-top:8rpx;}.app-status{padding:8rpx 15rpx;border-radius:24rpx;font-size:20rpx;font-weight:750;}.tone-warn{background:#fff1dc;color:#d97c12}.tone-info{background:#eaf3ff;color:#397bc8}.tone-success{background:#e8f7ee;color:#278854}.tone-muted{background:#f0f0f0;color:#888}.application-info{display:flex;flex-direction:column;gap:8rpx;margin-top:22rpx;padding:18rpx 20rpx;background:#f8f6f3;border-radius:18rpx;color:#766f68;font-size:22rpx;}.application-foot{display:flex;justify-content:space-between;margin-top:20rpx;color:#aaa29b;font-size:21rpx;}.application-foot text:last-child{color:#e5652d;font-weight:700;}
