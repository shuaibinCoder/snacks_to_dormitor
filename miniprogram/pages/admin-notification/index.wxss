.config-page{padding-top:28rpx;padding-bottom:80rpx;}.intro-card{padding:32rpx;border-radius:28rpx;background:linear-gradient(145deg,#fff0df,#fff);margin-bottom:24rpx;}.intro-title{font-size:36rpx;font-weight:900;}.intro-desc{font-size:23rpx;color:#786f67;line-height:1.65;margin-top:12rpx;}.diagnostic-card{padding:26rpx;margin-bottom:34rpx;}.diagnostic-title{font-size:29rpx;font-weight:900;margin-bottom:14rpx;}.diagnostic-row{display:flex;justify-content:space-between;padding:12rpx 0;color:#77716a;font-size:23rpx;}.diagnostic-row text:last-child{font-weight:750;color:#3d3935;}.diagnostic-row .ok{color:#258756;}.diagnostic-row .bad{color:#d9534f;}.diagnostic-row .warn{color:#da7b10;}.refresh-link{text-align:right;color:#e5652d;font-size:21rpx;font-weight:750;margin-top:12rpx;}.config-form{margin-top:20rpx;}.field-title,.delivery-title{margin-top:34rpx;}.field-tip{color:#807971;font-size:22rpx;line-height:1.65;padding:16rpx 6rpx;}.warning,.version-warning{padding:22rpx 25rpx;border-radius:20rpx;background:#fff7e5;color:#956a31;font-size:21rpx;line-height:1.6;margin-top:24rpx;}.version-warning{background:#fff0ed;color:#a84c44;}.save-btn{margin-top:32rpx;}.test-btn{margin-top:18rpx;}.picker{flex:1;text-align:right;color:#555;}.delivery-card{margin-top:20rpx;padding:8rpx 26rpx;}.delivery-row{padding:20rpx 0;border-bottom:1rpx solid #f0ede9;}.delivery-row:last-child{border:0;}.delivery-row>view:first-child{display:flex;justify-content:space-between;}.delivery-status{font-weight:850;}.status-SUCCESS{color:#278854}.status-SKIPPED{color:#d57b13}.status-FAILED_FINAL{color:#d34e49}.delivery-time{font-size:20rpx;color:#aaa29b;}.delivery-error,.delivery-success{font-size:21rpx;line-height:1.55;margin-top:8rpx;}.delivery-error{color:#b1534e}.delivery-success{color:#6e8e78}.no-delivery{text-align:center;color:#aaa29b;padding:42rpx 0;font-size:22rpx;}

.role-diagnostic{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-top:1rpx solid #f0ede9;}.role-diagnostic>view{display:flex;flex-direction:column;}.role-diagnostic>view text{font-size:23rpx;font-weight:750;}.role-diagnostic label{font-size:19rpx;color:#99928b;margin-top:5rpx;}.role-diagnostic>text{font-size:21rpx;font-weight:750;}.role-diagnostic .ok{color:#258756;}.role-diagnostic .warn{color:#da7b10;}
