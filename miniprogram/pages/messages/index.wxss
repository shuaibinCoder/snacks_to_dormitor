.message-header{background:#fff;position:sticky;top:0;z-index:10;box-shadow:0 4rpx 14rpx rgba(0,0,0,.03);}.tabs{height:88rpx;white-space:nowrap;}.tabs-inner{display:inline-flex;height:88rpx;padding:0 24rpx;gap:12rpx;align-items:center;}.tab{padding:13rpx 24rpx;border-radius:30rpx;color:#77716a;background:#f4f2ef;font-size:23rpx;}.tab.active{background:#282522;color:#fff;font-weight:800;}.header-actions{height:70rpx;border-top:1rpx solid #f1eeea;display:flex;justify-content:flex-end;align-items:center;padding:0 28rpx;gap:18rpx;color:#e4662d;font-size:22rpx;font-weight:700;}.divider{width:1rpx;height:24rpx;background:#ddd7d1;}.message-page{padding-top:22rpx;}.message-list{display:flex;flex-direction:column;gap:18rpx;}.message-card{display:flex;align-items:center;padding:24rpx;}.message-card.unread{background:linear-gradient(145deg,#fff8f0,#fff);}.message-icon{position:relative;width:78rpx;height:78rpx;border-radius:24rpx;background:#f7f3ee;display:flex;align-items:center;justify-content:center;font-size:36rpx;margin-right:20rpx;flex-shrink:0;}.unread-dot{position:absolute;right:-2rpx;top:-2rpx;width:18rpx;height:18rpx;border-radius:50%;background:#f0522b;border:4rpx solid #fff;}.message-main{flex:1;min-width:0;}.message-top{display:flex;justify-content:space-between;gap:16rpx;}.message-title{font-size:28rpx;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.message-time{font-size:19rpx;color:#aaa39c;flex-shrink:0;}.message-summary{font-size:23rpx;color:#77716a;line-height:1.55;margin-top:9rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;}.message-meta{display:flex;align-items:center;gap:12rpx;margin-top:12rpx;color:#9c958e;font-size:19rpx;}.priority{padding:4rpx 9rpx;border-radius:10rpx;}.priority-URGENT{background:#fff0ed;color:#d64c45}.priority-HIGH{background:#fff1df;color:#d57b13}.priority-NORMAL{background:#eef4fa;color:#52708d}.arrow{font-size:38rpx;color:#c5beb7;margin-left:12rpx;}.empty>text:last-child{display:block;font-size:22rpx;margin-top:12rpx;}
