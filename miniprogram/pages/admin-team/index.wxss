.team-page{padding-top:28rpx;}.notice-card{padding:23rpx 26rpx;border-radius:22rpx;background:#fff1e5;color:#895b3f;font-size:23rpx;line-height:1.6;margin-bottom:34rpx;}.add-form{margin-top:20rpx;padding-bottom:24rpx;}.picker{flex:1;text-align:right;}.save-btn{margin-top:24rpx;height:82rpx;}.list-title{margin-top:38rpx;}.team-list{display:flex;flex-direction:column;gap:18rpx;margin-top:20rpx;}.team-card{display:flex;align-items:center;padding:24rpx;}.team-avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:#eaf2fd;display:flex;align-items:center;justify-content:center;font-size:35rpx;margin-right:18rpx;}.team-main{flex:1;min-width:0;}.team-main>view{font-size:28rpx;font-weight:850;}.team-main>text{display:block;color:#77716a;font-size:21rpx;margin-top:6rpx;}.team-main>label{display:block;color:#aaa39c;font-size:18rpx;margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
