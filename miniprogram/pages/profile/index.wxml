<view class="profile-hero">
  <view class="avatar">🎓</view><view class="profile-info"><view class="nickname">{{profile.contactName || '同学，你好'}}</view><view class="profile-sub">今晚也要好好补充能量</view></view>
</view>
<view class="page profile-page">
  <view class="merchant-card card" bindtap="goMerchant">
    <view class="merchant-copy"><view class="merchant-tag">STUDENT SHOP</view><view class="merchant-title">{{myStore ? '进入商家工作台' : '把你的零食卖给同学'}}</view><view class="merchant-desc">{{myStore ? myStore.name + ' · 管商品、库存和订单' : '1分钟创建店铺，分享店名就能接单'}}</view></view><view class="merchant-art">🏪</view>
  </view>
  <view class="menu-card card">
    <view class="menu-item" bindtap="goOrders"><view class="menu-icon orange-bg">🧾</view><text>我的订单</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goMerchant"><view class="menu-icon green-bg">🛠</view><text>{{myStore ? '商家工作台' : '我要开店'}}</text><text class="menu-arrow">›</text></view>
    <button class="menu-item share-row" open-type="share"><view class="menu-icon blue-bg">📣</view><text>分享小程序</text><text class="menu-arrow">›</text></button>
    <view class="menu-item" bindtap="about"><view class="menu-icon gray-bg">💡</view><text>关于与规则</text><text class="menu-arrow">›</text></view>
  </view>
  <view class="debug-reset" bindtap="resetDemo">重置本机体验数据</view>
</view>
