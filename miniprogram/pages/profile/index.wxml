<view class="profile-hero">
  <view class="avatar">🎓</view><view class="profile-info"><view class="nickname">{{profile.contactName || '同学，你好'}}</view><view class="profile-sub">{{platformRoleName || '今晚也要好好补充能量'}}</view></view>
</view>
<view class="page profile-page">
  <view wx:if="{{identity && identity.platformRole}}" class="admin-card" bindtap="goAdmin">
    <view><view class="admin-tag">PLATFORM CONSOLE</view><view class="admin-title">进入平台管理后台</view><view class="admin-desc">{{platformRoleName}} · 商家审批与店铺运营</view></view><view class="admin-art">🛡️</view>
  </view>

  <view class="merchant-card card" bindtap="goMerchant">
    <view class="merchant-copy"><view class="merchant-tag">STUDENT SHOP</view><view class="merchant-title">{{myStore && myStore.approvalStatus === 'APPROVED' ? '进入商家工作台' : (application ? '查看入驻申请进度' : '申请开设宿舍小店')}}</view><view class="merchant-desc">{{myStore && myStore.approvalStatus === 'APPROVED' ? myStore.name + ' · 管商品、库存和订单' : (application ? application.statusText + ' · ' + application.publicMessage : '提交申请，平台联系并审核通过后上线')}}</view></view><view class="merchant-art">🏪</view>
  </view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="goMessages"><view class="menu-icon red-bg">🔔</view><text>消息通知</text><text wx:if="{{unreadCount}}" class="unread-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goOrders"><view class="menu-icon orange-bg">🧾</view><text>我的订单</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goMerchant"><view class="menu-icon green-bg">🛠</view><text>{{myStore && myStore.approvalStatus === 'APPROVED' ? '商家工作台' : '商家入驻'}}</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="copyIdentity"><view class="menu-icon blue-bg">🪪</view><text>复制我的身份ID</text><text class="menu-arrow">›</text></view>
    <button class="menu-item share-row" open-type="share"><view class="menu-icon purple-bg">📣</view><text>分享小程序</text><text class="menu-arrow">›</text></button>
    <view class="menu-item" bindtap="about"><view class="menu-icon gray-bg">💡</view><text>关于与规则</text><text class="menu-arrow">›</text></view>
  </view>
  <view class="identity-hint">本次运行后端：{{backendLabel || '正在获取'}}。本机测试切换不影响他人，冷启动默认 Java 云托管。</view>
  <view class="identity-hint">身份ID用于平台授权运营或管理员角色，请勿随意公开。</view>
  <view class="debug-reset" bindtap="resetDemo">重置本机体验数据</view>
</view>
