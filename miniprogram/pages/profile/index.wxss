.profile-hero{padding:52rpx 36rpx 72rpx;background:linear-gradient(145deg,#fff0df,#fff9ef);display:flex;align-items:center;border-radius:0 0 52rpx 52rpx;}.avatar{width:112rpx;height:112rpx;border-radius:40rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(120,80,40,.1);display:flex;align-items:center;justify-content:center;font-size:58rpx;margin-right:24rpx;}.nickname{font-size:40rpx;font-weight:900;}.profile-sub{color:#897b6f;font-size:24rpx;margin-top:10rpx;}.profile-page{margin-top:-40rpx;}.merchant-card{min-height:230rpx;padding:34rpx;background:linear-gradient(135deg,#282522,#433c36);color:#fff;display:flex;align-items:center;overflow:hidden;}.merchant-copy{flex:1;position:relative;z-index:1;}.merchant-tag{color:#f7a06f;font-size:19rpx;font-weight:800;letter-spacing:3rpx;}.merchant-title{font-size:36rpx;font-weight:900;margin-top:16rpx;}.merchant-desc{color:#c9c0b8;font-size:23rpx;margin-top:13rpx;}.merchant-art{font-size:94rpx;transform:rotate(5deg);}.menu-card{margin-top:24rpx;padding:0 26rpx;}.menu-item{width:100%;min-height:108rpx;display:flex;align-items:center;border-bottom:1rpx solid #f0ede9;text-align:left;background:transparent;color:#292622;}.menu-item:last-child{border-bottom:0;}.menu-icon{width:60rpx;height:60rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;margin-right:20rpx;font-size:29rpx;}.orange-bg{background:#fff0e5}.green-bg{background:#e9f7ef}.blue-bg{background:#eaf3ff}.gray-bg{background:#f1f1f1}.menu-item>text:nth-child(2){flex:1;font-weight:700;}.menu-arrow{font-size:42rpx;color:#c8c2bc;}.share-row{padding:0;font-size:28rpx;line-height:normal;border-radius:0;}.debug-reset{text-align:center;color:#b2aaa3;font-size:22rpx;padding:45rpx 0;}
