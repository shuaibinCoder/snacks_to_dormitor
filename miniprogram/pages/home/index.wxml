<view class="hero">
  <view class="hero-bubble bubble-one">🍿</view>
  <view class="hero-bubble bubble-two">🥤</view>
  <view class="hero-content">
    <view class="eyebrow">DORM SNACKS · 随叫随到</view>
    <view class="hero-title">今晚想吃点什么？</view>
    <view class="hero-subtitle">输入代理告诉你的店铺名，直接找到他的小店</view>

    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input class="search-input" value="{{query}}" placeholder="搜索店铺名，如：阿豪的深夜补给站" confirm-type="search" bindinput="onInput" bindconfirm="onSearch" />
      <text wx:if="{{query}}" class="clear" bindtap="clearSearch">×</text>
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>
</view>

<view class="page home-page">
  <view class="quick-tip card">
    <view class="tip-icon">💬</view>
    <view class="tip-content">
      <view class="tip-title">朋友分享店铺？</view>
      <view class="tip-desc">点击分享卡片可直达小店，也可以在上方搜店名</view>
    </view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">{{searched ? '搜索结果' : '大家常逛'}}</view>
      <view class="section-sub">{{searched ? '找到 ' + stores.length + ' 家小店' : '营业时间以店铺展示为准'}}</view>
    </view>
    <view class="merchant-entry" bindtap="goOpenStore">我要开店 →</view>
  </view>

  <view wx:if="{{loading}}" class="loading-list">
    <view class="skeleton card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <view wx:elif="{{stores.length}}" class="store-list">
    <view class="store-card card" wx:for="{{stores}}" wx:key="_id" data-id="{{item._id}}" bindtap="openStore">
      <view class="store-logo">{{item.logoEmoji}}</view>
      <view class="store-main">
        <view class="store-topline">
          <view class="store-name">{{item.name}}</view>
          <view class="open-badge {{item.isOpen ? 'is-open' : 'is-closed'}}">{{item.isOpen ? '营业中' : '已打烊'}}</view>
        </view>
        <view class="store-notice">{{item.notice}}</view>
        <view class="store-metrics">
          <text class="rating">★ {{item.rating}}</text>
          <text>月售 {{item.monthlySales}}</text>
          <text>{{item.deliveryMinutes}}分钟左右</text>
        </view>
        <view class="store-bottom">
          <view class="store-tags">
            <text class="tag">{{item.minimumOrder ? item.minimumOrderText + '元起送' : '0元起送'}}</text>
            <text class="tag">{{item.deliveryFeeText}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty-icon">🔍</text>
    <view>没有找到这个店铺</view>
    <view class="empty-sub">检查一下店名，或者让商家直接分享店铺卡片</view>
  </view>
</view>
