.product-edit-page{padding-bottom:180rpx;}.preview-product{display:flex;align-items:center;padding:28rpx;}.preview-image{width:128rpx;height:128rpx;border-radius:30rpx;background:linear-gradient(145deg,#fff0d8,#f9dfbd);display:flex;align-items:center;justify-content:center;font-size:62rpx;margin-right:24rpx;}.preview-name{font-size:31rpx;font-weight:850;}.preview-meta{color:#99928b;font-size:22rpx;margin-top:9rpx;}.preview-price{color:#ed5c24;font-size:32rpx;font-weight:850;margin-top:14rpx;}.section-label{font-size:25rpx;font-weight:800;color:#77716a;margin:30rpx 8rpx 15rpx;}.emoji-grid{padding:22rpx;display:grid;grid-template-columns:repeat(5,1fr);gap:14rpx;}.emoji-item{height:82rpx;border-radius:22rpx;background:#f7f4ef;display:flex;align-items:center;justify-content:center;font-size:40rpx;border:3rpx solid transparent;}.emoji-item.selected{background:#fff0e5;border-color:#f57539;}.picker{flex:1;text-align:right;}.unit{color:#999;margin-left:8rpx;}.stock-tip{padding:24rpx 10rpx;color:#a49d95;font-size:22rpx;line-height:1.6;}
.preview-photo{display:block;background:#f2f2f2;}.upload-row{display:flex;align-items:center;padding:24rpx 26rpx;}.upload-icon{width:72rpx;height:72rpx;border-radius:22rpx;background:#fff0e5;display:flex;align-items:center;justify-content:center;font-size:34rpx;margin-right:20rpx;}.upload-row>view:nth-child(2){flex:1;}.upload-title{font-weight:850;}.upload-desc{font-size:21rpx;color:#9e978f;margin-top:7rpx;}.upload-arrow{font-size:42rpx;color:#bbb3ac;}
