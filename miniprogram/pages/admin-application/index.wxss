.detail-page{display:flex;flex-direction:column;gap:22rpx;}.application-hero{padding:30rpx;display:flex;justify-content:space-between;align-items:flex-start;background:linear-gradient(145deg,#fff0df,#fff);}.hero-eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#e16a32;font-weight:800;}.hero-name{font-size:40rpx;font-weight:900;margin-top:12rpx;}.hero-owner{color:#857e77;font-size:23rpx;margin-top:9rpx;}.status-badge{padding:9rpx 16rpx;border-radius:24rpx;font-size:21rpx;font-weight:800;}.tone-warn{background:#fff0dc;color:#da7c10}.tone-info{background:#eaf3ff;color:#397bc8}.tone-success{background:#e8f7ee;color:#278854}.tone-muted{background:#eee;color:#888}.contact-card,.info-card,.payment-form,.payment-records,.message-card,.actions-card{padding:28rpx;}.card-title{font-size:29rpx;font-weight:900;margin-bottom:18rpx;}.info-row{display:flex;justify-content:space-between;gap:30rpx;padding:15rpx 0;color:#716b65;font-size:24rpx;}.info-row text:first-child{color:#9b948d;flex-shrink:0;}.info-row text:last-child{text-align:right;}.call-btn{height:76rpx;border-radius:38rpx;background:#fff0e5;color:#df642c;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:20rpx;}.payment-textarea{width:100%;min-height:140rpx;background:#f7f5f2;border-radius:18rpx;padding:20rpx;margin-top:18rpx;font-size:23rpx;line-height:1.6;}.payment-record{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f0ede9;}.payment-record:last-child{border:0;}.payment-record>view{display:flex;flex-direction:column;}.payment-record>view text{font-size:30rpx;color:#e65e28;font-weight:850;}.payment-record label,.payment-record>text{font-size:20rpx;color:#99928b;margin-top:5rpx;}.message-card>view:last-child{padding:20rpx;border-radius:18rpx;background:#f8f6f3;color:#746e68;line-height:1.6;}.action-grid{display:flex;gap:16rpx;}.action-grid>view{flex:1;}.danger-action{height:92rpx;border-radius:46rpx;background:#f2f0ed;color:#d9534f;display:flex;align-items:center;justify-content:center;font-weight:800;}.text-actions{display:flex;justify-content:center;gap:50rpx;margin-top:25rpx;color:#e2672e;font-size:23rpx;}.text-actions text:last-child{color:#d34d49;}.completed-tip{text-align:center;color:#288a57;background:#eaf8ef;padding:24rpx;border-radius:20rpx;font-weight:750;}
